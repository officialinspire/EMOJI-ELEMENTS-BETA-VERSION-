{
  "name": "emoji-elements",
  "private": true,
  "description": "EMOJI ELEMENTS browser card battler. The game has no build step or runtime dependencies; this file holds test scripts (card catalog check needs only Node; rules and smoke tests need Playwright).",
  "scripts": {
    "test": "node tests/card-audit.mjs",
    "cards": "node tests/card-audit.mjs",
    "cards:write": "node tests/card-audit.mjs --write",
    "serve": "python3 -m http.server 8000",
    "smoke": "node tests/smoke.mjs",
    "smoke:desktop": "node tests/smoke.mjs --project=desktop",
    "smoke:mobile": "node tests/smoke.mjs --project=mobile",
    "rules": "node --test tests/rules.test.mjs",
    "combat": "node --test tests/combat.test.mjs",
    "persistence": "node --test tests/persistence.test.mjs tests/achievement-hardening.test.mjs",
    "progression": "node --test tests/progression.test.mjs",
    "collection": "node --test tests/collection.test.mjs",
    "collection:shots": "node tests/collection-shots.mjs",
    "effects": "node --test tests/effects.test.mjs",
    "ui": "node tests/ui-audit.mjs",
    "menu": "node tests/menu-audit.mjs",
    "cards:ui": "node tests/card-faces.mjs",
    "themes": "node tests/theme-audit.mjs",
    "ai": "node --test tests/ai.test.mjs",
    "feedback": "node --test tests/feedback.test.mjs",
    "feedback:shots": "node tests/feedback-shots.mjs",
    "packs": "node --test tests/packs.test.mjs",
    "packs:shots": "node tests/pack-shots.mjs",
    "regression": "node --test tests/regression.test.mjs",
    "battle": "node --test tests/battle.test.mjs",
    "audio": "node --test tests/audio.test.mjs",
    "achievements": "node --test tests/achievements.test.mjs",
    "achievements:doc": "node tests/achievements-doc.mjs --write",
    "cross-browser": "node tests/cross-browser.mjs",
    "ai:sim": "node tests/ai-sim.mjs",
    "release": "node tests/release.mjs",
    "verify": "node tests/verify.mjs",
    "determinism": "node --test tests/determinism.test.mjs",
    "stabilization": "node --test tests/stabilization.test.mjs",
    "pwa:build": "node scripts/build-pwa.mjs",
    "pwa:check": "node scripts/build-pwa.mjs --check",
    "pwa": "node --test tests/pwa.test.mjs"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "1.56.1"
  }
}
